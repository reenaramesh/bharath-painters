DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=bharath-painters-api.onrender.com
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@PRIVATE_POSTGRES_HOST/DB_NAME?sslmode=require
CSRF_TRUSTED_ORIGINS=https://bharath-painters-chi.vercel.app
CORS_ALLOWED_ORIGINS=https://bharath-painters-chi.vercel.app
BHARATH_PUBLIC_BACKEND_URL=https://bharath-painters-api.onrender.com
# Point this to a persistent disk or mounted media volume in production.
DJANGO_MEDIA_ROOT=/var/lib/bharath-painters/media
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=replace-with-server-side-google-places-api-key

# Optional: a stable key pair is derived from DJANGO_SECRET_KEY if these are unset.
# For a separate key pair, generate one and keep it unchanged across deployments.
# WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-base64url-public-key
# WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-base64url-private-key
# WEB_PUSH_VAPID_SUBJECT=mailto:support@bharathpainters.in

# Production defaults to AUTO, preserving the active admin Email & OTP Setup.
# DEBUG defaults to DJANGO, preventing an active admin API provider sending mail.
# Set AUTO explicitly to opt into admin-managed transports during development.
# Explicit DJANGO, SMTP or BREVO overrides its transporst and sender settings.
# Without environment overrides, DEBUG=true writes mail to backend/.email-output/.
# Keep that directory private; it contains local authentication codes.
EMAIL_PROVIDER=BREVO
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Keep authentication email OFF during infrastructure readiness.
AUTH_EMAIL_ENABLED=false
PASSWORD_RECOVERY_DELIVERY_MODE=queued
# Optional HTTPS transport: EMAIL_PROVIDER=BREVO (SMTP variables are then unused).
# Set this only on the backend, never as VITE_BREVO_API_KEY or in frontend files.
BREVO_API_KEY=your-brevo-api-key
# Sandbox validates API requests but does NOT deliver mail or issue usable OTPs.
BREVO_SANDBOX=false
# Keep false until the sender is verified and live email is deliberately enabled.
# Non-sandbox sends also require an active matching sender from GET /v3/senders.
BREVO_LIVE_ENABLED=true
# Optional one-recipient test: leave OFF until separately approved.
# Keep AUTH_EMAIL_ENABLED=false even during controlled real sends.
BREVO_CONTROLLED_TEST_ENABLED=true
BREVO_TEST_RECIPIENT=bharathapps26@gmail.com
# Enable only after harmless-test delivery is confirmed in Brevo AND Gmail.
BREVO_TEST_OTP_ENABLED=false
FRONTEND_URL=https://bharath-painters-chi.vercel.app
# Without an explicit FRONTEND_URL, DEBUG defaults to http://localhost:5173.
# Amazon SES Asia Pacific (Mumbai). SMTP credentials are region-specific.
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
# Use the SES SMTP username and password, not an AWS access key or sender email.
EMAIL_HOST_USER=replace-with-ses-smtp-username
EMAIL_HOST_PASSWORD=replace-with-ses-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this server-only key stable and backed up; never use a VITE_ variable.
EMAIL_SETUP_ENCRYPTION_KEY=
DEFAULT_FROM_EMAIL="Bharath Painters <bharathapps26@gmail.com>"
LEGAL_OPERATOR_NAME=Bharath Painters
LEGAL_OPERATOR_ADDRESS=Enter the registered business address
LEGAL_CONTACT_EMAIL=support@bharathpainters.in

# One shared Redis primary is required; never use locmem/file/dummy in production.
# Use the exact private connection URL supplied by your provider, or rediss://
# for TLS connections. Keep credentials server-only. Prefer noeviction policy.
DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
DJANGO_CACHE_LOCATION=rediss://REDIS_USER:REDIS_PASSWORD@REDIS_HOST:REDIS_PORT/0
DJANGO_CACHE_TIMEOUT=300

# Auth rate limits ignore X-Forwarded-For unless the actual peer is in this list.
# Set only the real reverse proxy networks; never trust all public addresses.
AUTH_TRUSTED_PROXY_CIDRS=

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Schedule cleanup_application_analytics daily; includes raw and aggregated usage.
APPLICATION_ANALYTICS_RETENTION_DAYS=90
