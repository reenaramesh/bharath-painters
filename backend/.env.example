DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=api.bharathpainters.in
CSRF_TRUSTED_ORIGINS=https://app.bharathpainters.in
BHARATH_PUBLIC_BACKEND_URL=https://api.bharathpainters.in

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@bharathpainters.in
EMAIL_HOST_PASSWORD=replace-with-provider-app-password
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Bharath Painters <no-reply@bharathpainters.in>

# A shared cache keeps OTP and API throttle counters consistent across workers.
# FileBasedCache works for a single VPS. Use Redis for multiple application hosts.
DJANGO_CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
DJANGO_CACHE_LOCATION=/var/tmp/bharath-painters-cache
DJANGO_CACHE_TIMEOUT=300

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
