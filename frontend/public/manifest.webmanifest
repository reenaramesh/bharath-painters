{
  "id": "/",
  "name": "Bharath Apps",
  "short_name": "Bharath Apps",
  "description": "Manage service customers, quotations, jobs and projects.",
  "start_url": "/",
  "scope": "/",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f5f7fc",
  "theme_color": "#0d1736",
  "orientation": "portrait-primary",
  "categories": ["business", "productivity"],
  "icons": [{ "src": "/pwa-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }],
  "shortcuts": [
    { "name": "Dashboard", "short_name": "Dashboard", "url": "/dashboard", "icons": [{ "src": "/pwa-icon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "New quotation", "short_name": "Quotation", "url": "/quotations/new", "icons": [{ "src": "/pwa-icon.svg", "sizes": "any", "type": "image/svg+xml" }] }
  ]
}
