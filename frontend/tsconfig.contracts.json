{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "src/types/contracts.ts",
    "src/types/apiValidation.ts",
    "src/types/calculationSafety.ts",
    "src/types/financialDisplay.ts",
    "src/utils/quotationPricing.js",
    "src/utils/measurementRecords.js",
    "src/utils/invoiceSavePayload.js",
    "src/utils/offlineOperationQueue.js"
  ]
}
