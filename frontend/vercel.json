{
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "X-Content-Type-Options", "value": "nosniff"}
    ]},
    {"source": "/employee-activation/:path*", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/verify-email", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/forgot-password", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
