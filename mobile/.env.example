# Include /api. For a device, use a reachable LAN hostname or HTTPS server.
# Never place secrets in EXPO_PUBLIC variables.
EXPO_PUBLIC_API_URL=https://your-existing-api.example.com/api
# Turn on only after quotations migrations 0121 and 0122 are applied and verified in the target API database.
EXPO_PUBLIC_OFFLINE_MEASUREMENTS_ENABLED=false
